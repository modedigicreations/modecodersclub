generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CertificateStatus {
  ACTIVE
  REVOKED
}

// Better Auth's own tables (naming/shape required by the adapter).
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("learner") @db.VarChar(32)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  issuedCertificates  Certificate[]  @relation("CertificateIssuer")
  certificates        Certificate[]  @relation("CertificateRecipient")
  revokedCertificates Certificate[]  @relation("CertificateRevoker")
  createdForumSessions ForumSession[] @relation("ForumSessionCreator")
  forumPosts          ForumPost[]

  instructorCourses  CourseInstructor[]
  enrollments        Enrollment[]       @relation("EnrolledUser")
  enrollmentsCreated Enrollment[]       @relation("EnrollmentCreator")

  labSubmissions     LabSubmission[]
  assessmentAttempts AssessmentAttempt[]

  // Provisioned via the Modebills Enterprise SSO launcher — exempt from the
  // individual-subscription gate in enrollStudent (their school already pays).
  isEnterpriseSso Boolean        @default(false)
  subscriptions   Subscription[]

  courseGenerationJobs CourseGenerationJob[]
  courseReviews        CourseReview[]
  learningDays         LearningDay[]
  blogPosts            BlogPost[]
  badges               UserBadge[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Dynamic course catalog — replaces the hardcoded array in src/lib/courses.ts.
model Course {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  category    String   @db.VarChar(80)
  level       String   @db.VarChar(160)
  description String   @db.VarChar(500)
  icon        String   @db.VarChar(8)
  color       String   @db.VarChar(20)
  duration    String   @db.VarChar(80)
  price       String   @db.VarChar(80)
  audience    String   @db.VarChar(300)
  outcomes    String[]
  order       Int      @default(0)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Admin-togglable gate: paid courses require an active Subscription (or
  // isEnterpriseSso) to enroll into — see enrollStudent. `price` above stays
  // display-only marketing text regardless of this flag.
  isFree Boolean @default(true)

  // Draft courses (e.g. created by the AI course generator) are hidden from the
  // public catalogue and can't take enrollments until an admin publishes them.
  isDraft Boolean @default(false)

  lessons        Lesson[]
  instructors    CourseInstructor[]
  enrollments    Enrollment[]
  generationJobs CourseGenerationJob[]
  certificates   Certificate[]
  reviews        CourseReview[]

  @@index([order])
}

model FreeResource {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  category    String   @db.VarChar(80)
  description String   @db.VarChar(500)
  icon        String   @db.VarChar(8)
  color       String   @db.VarChar(20)
  time        String   @db.VarChar(40)
  order       Int      @default(0)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

// Completion certificates (see src/lib/certificate-verification.ts).
// Admin-issued ones have issuedById; automatic ones (src/lib/course-completion.ts)
// have issuedById null and are linked to the learner (userId) and course (courseId).
model Certificate {
  id                String            @id @default(cuid())
  certificateNumber String            @unique @db.VarChar(40)
  recipientName     String            @db.VarChar(120)
  courseName        String            @db.VarChar(120)
  status            CertificateStatus @default(ACTIVE)
  issuedAt          DateTime          @default(now())
  issuedById        String?
  issuedBy          User?             @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  userId            String?
  user              User?             @relation("CertificateRecipient", fields: [userId], references: [id], onDelete: SetNull)
  courseId          String?
  course            Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  revokedAt         DateTime?
  revokedById       String?
  revokedBy         User?             @relation("CertificateRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  revocationReason  String?           @db.VarChar(1000)

  @@index([issuedAt])
  @@index([userId, courseId])
}

// Weekly community discussion sessions ("Community" nav).
model ForumSession {
  id          String   @id @default(cuid())
  weekNumber  Int
  title       String   @db.VarChar(160)
  prompt      String   @db.VarChar(2000)
  startsAt    DateTime
  createdById String
  createdBy   User     @relation("ForumSessionCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  posts ForumPost[]

  @@index([startsAt])
}

model ForumPost {
  id        String       @id @default(cuid())
  sessionId String
  session   ForumSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  body      String       @db.VarChar(4000)
  createdAt DateTime     @default(now())
  hiddenAt  DateTime?

  @@index([sessionId, createdAt])
  @@index([authorId, createdAt])
}

// Lessons, instructor assignment, enrollment, and progress — the
// student-facing "take classes in your dashboard" feature.
model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(160)
  content     String   @db.VarChar(8000)
  videoUrl    String?  @db.VarChar(500)
  position    Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress   LessonProgress[]
  lab        Lab?
  assessment Assessment?

  @@index([courseId, position])
}

// AI-assisted coding lab attached to a lesson (one per lesson). Hints are
// generated on request and never stored — only the student's own code is
// persisted here. See src/lib/anthropic.ts and the /api/labs/* routes.
model Lab {
  id           String   @id @default(cuid())
  lessonId     String   @unique
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  instructions String   @db.VarChar(4000)
  starterHtml  String   @db.VarChar(4000) @default("")
  starterCss   String   @db.VarChar(4000) @default("")
  starterJs    String   @db.VarChar(4000) @default("")
  hintsEnabled Boolean  @default(false)
  // Auto-grading checks (see src/lib/lab-checks.ts), e.g. ["html: h1 | Add a heading"].
  checks       Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions LabSubmission[]
}

model LabSubmission {
  id        String   @id @default(cuid())
  labId     String
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  html      String   @db.VarChar(4000) @default("")
  css       String   @db.VarChar(4000) @default("")
  js        String   @db.VarChar(4000) @default("")
  // Last "Check my work" result; passedAt is set the first time every check passes.
  checksPassed Int       @default(0)
  checksTotal  Int       @default(0)
  checkedAt    DateTime?
  passedAt     DateTime?
  updatedAt DateTime @updatedAt

  @@unique([labId, userId])
}

// AI-assisted multiple-choice assessment attached to a lesson (one per
// lesson). `questions` shape: { question, options: string[4], correctIndex }[].
model Assessment {
  id         String   @id @default(cuid())
  lessonId   String   @unique
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions  Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attempts AssessmentAttempt[]
}

model AssessmentAttempt {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      Json
  score        Int
  total        Int
  submittedAt  DateTime   @updatedAt

  @@unique([assessmentId, userId])
}

model CourseInstructor {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([courseId, userId])
  @@index([userId])
}

model Enrollment {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("EnrolledUser", fields: [userId], references: [id], onDelete: Cascade)
  enrolledById String
  enrolledBy   User     @relation("EnrollmentCreator", fields: [enrolledById], references: [id])
  enrolledAt   DateTime @default(now())

  lessonProgress LessonProgress[]

  @@unique([courseId, userId])
  @@index([userId])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime   @default(now())

  @@unique([enrollmentId, lessonId])
}

// One row per payment, not a single mutable flag — keeps full history as a
// subscription is renewed. hasActiveSubscription() (src/lib/subscriptions.ts)
// checks for any row with status "active" and a future expiresAt.
model Subscription {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String   @default("active") @db.VarChar(20) // "active" | "expired"
  startedAt         DateTime @default(now())
  expiresAt         DateTime
  paystackReference String   @unique @db.VarChar(100)
  amountKobo        Int
  createdAt         DateTime @default(now())
  // Set when the "expires in 7 days" / "has expired" emails go out (once each).
  reminderSentAt      DateTime?
  expiredNoticeSentAt DateTime?

  @@index([userId, expiresAt])
}

// One AI course-generation run (the A-EduNet pipeline in src/lib/course-generator).
// Admin-only. The course it creates is a draft unless autoPublish was ticked.
model CourseGenerationJob {
  id           String    @id @default(cuid())
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  topic        String    @db.VarChar(300)
  audience     String    @db.VarChar(300)
  level        String    @db.VarChar(40)
  lessonTarget Int
  includeLabs  Boolean   @default(true)
  autoPublish  Boolean   @default(false)
  isFree       Boolean   @default(false)
  price        String    @default("") @db.VarChar(80)
  status       String    @default("queued") @db.VarChar(20) // queued | running | succeeded | failed
  stage        String    @default("") @db.VarChar(200)
  lessonsTotal Int       @default(0)
  lessonsDone  Int       @default(0)
  courseId     String?
  course       Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  error        String?   @db.VarChar(500)
  model        String    @default("") @db.VarChar(60)
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([createdById, createdAt])
  @@index([status])
}

// A learner's rating (1-5) and optional comment for a course they're taking.
// One per learner per course (editable). Admins can hide a review (hiddenAt).
model CourseReview {
  id        String    @id @default(cuid())
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?   @db.VarChar(1000)
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([courseId, userId])
  @@index([courseId, hiddenAt])
}

// One row per learner per day they did something (finished a lesson, took a
// quiz, checked a lab), in LEARNING_TIMEZONE. Streaks are worked out from these.
model LearningDay {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date

  @@id([userId, day])
}

// Badges a learner has earned; the badge list itself is in src/lib/achievements.ts.
model UserBadge {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     String   @db.VarChar(40)
  awardedAt DateTime @default(now())

  @@id([userId, badge])
}

// Blog posts written in the admin TipTap editor. content is TipTap JSON,
// rendered on the server through an allowlist (src/lib/blog-render.tsx).
// A post is public when publishedAt is set.
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String    @db.VarChar(160)
  excerpt         String    @default("") @db.VarChar(300)
  content         Json
  coverImageUrl   String?   @db.VarChar(1000)
  tags            String[]  @default([])
  authorId        String?
  author          User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([publishedAt])
}
